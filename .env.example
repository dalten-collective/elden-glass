# Base URL for sitemap, RSS, and OG images
NEXT_PUBLIC_BASE_URL=https://eldenringisthelargeglass.com

# PostHog browser analytics (see docs/analytics.md). Both keys are required
# for the browser shim to initialize; otherwise analytics degrades silently.
# Use a dedicated dev project locally — never the production project.
# NEXT_PUBLIC_POSTHOG_KEY=phc_dev_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: free-form environment label tagged on every event. When unset,
# the shim derives a default from Vercel's automatic VERCEL_ENV variable
# ('production' / 'preview' / 'development') and falls back to 'local'.
# NEXT_PUBLIC_ANALYTICS_ENV=local

# Optional: when "1" or "true", the browser shim emits verbose console logs.
# Off in production.
# NEXT_PUBLIC_ANALYTICS_DEBUG=0

# Server-only kill switch. When "1", both browser and server analytics
# no-op regardless of any other configuration. Used for incident response.
# ANALYTICS_DISABLED=0
