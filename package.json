{
  "name": "eldengglass",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:actions": "github-actionlint",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run lint:actions && npm run format:check && npm run typecheck && NEXT_TELEMETRY_DISABLED=1 npm run build",
